{
  "name": "hsk-tuky",
  "main": "public/_worker.js",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hsk-tuky",
      "database_id": "67808f91-91a7-4434-9113-597b3d2d2f6c"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_MODEL_FALLBACK": "@cf/zai-org/glm-4.7-flash"
  }
}
